# Web (com network_mode: host, a UI fica em http://IP:8080)
PORT=8080
SECRET_KEY=change-me

# Kindle display (Paperwhite 10th gen defaults)
KINDLE_WIDTH=1072
KINDLE_HEIGHT=1448
KINDLE_CONTRAST=1.15

KINDLE_REMOTE_PATH=/mnt/us/screensaver/current.png
KINDLE_CLEAR_SCREENSAVER_DIR=true
KINDLE_REFRESH_CMD=
KINDLE_DOCUMENTS_DIR=/mnt/us/documents
KINDLE_KOREADER_DIR=/mnt/us/koreader
KINDLE_COLLECTION_FILE=/mnt/us/koreader/settings/collection.lua

# Livros
BOOK_MAX_CONTENT_LENGTH=209715200
EBOOK_CONVERT_BIN=ebook-convert
EBOOK_META_BIN=ebook-meta
EBOOK_CONVERT_TIMEOUT=600

# SSH — hotspot Kindle em 10.42.0.x
KINDLE_HOST=10.42.0.33
KINDLE_PORT=2222
KINDLE_USER=root
KINDLE_PASSWORD=
KINDLE_SSH_KEY=/keys/id_rsa
KINDLE_SSH_TIMEOUT=20
