# Web
PORT=8080
SECRET_KEY=change-me

# Kindle display (Paperwhite 10th gen defaults)
KINDLE_WIDTH=1072
KINDLE_HEIGHT=1448
KINDLE_CONTRAST=1.15

# Pasta do screensaver do KOReader (configure a mesma pasta no app)
KINDLE_REMOTE_PATH=/mnt/us/screensaver/current.png
# Limpa outros PNG/JPG da pasta antes de enviar (evita random pegar imagem antiga)
KINDLE_CLEAR_SCREENSAVER_DIR=true
# Opcional: comando SSH após o upload. Deixe vazio para modo screensaver.
KINDLE_REFRESH_CMD=

# SSH (password auth)
KINDLE_HOST=192.168.1.50
KINDLE_PORT=2222
KINDLE_USER=root
KINDLE_PASSWORD=your-kindle-password
KINDLE_SSH_TIMEOUT=20
